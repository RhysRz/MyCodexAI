{
  "name": "mycodexai-cloud-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create mycodexai-cloud",
    "db:migrate:local": "wrangler d1 migrations apply mycodexai-cloud --local",
    "db:migrate": "wrangler d1 migrations apply mycodexai-cloud --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.118.0"
  }
}
