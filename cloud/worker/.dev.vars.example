# Local development only. Copy to .dev.vars and never commit the real file.
GITHUB_TOKEN=replace-with-fine-grained-github-token
RUNNER_CALLBACK_SECRET=replace-with-a-random-32-byte-secret
CLOUD_BOOTSTRAP_TOKEN=replace-with-a-different-random-32-byte-secret
AUTH_ENCRYPTION_KEY=replace-with-an-independent-random-32-byte-secret
OAUTH_GOOGLE_CLIENT_ID=replace-with-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
OAUTH_GITHUB_CLIENT_ID=replace-with-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=replace-with-github-client-secret
