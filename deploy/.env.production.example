# Copy to /etc/mycodexai/mycodexai.env on a dedicated Linux VM. Never commit it.
APP_NAME=MyCodexAI
ENVIRONMENT=production
DEBUG=false

# Ollama must only listen on the private loopback interface of this VM.
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_API_KEY=ollama
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_MAX_TOKENS=512
RESOURCE_GUARD_ENABLED=true
RESOURCE_GUARD_MIN_AVAILABLE_MB=768
RESOURCE_GUARD_MAX_WAIT_SECONDS=180

# Keep all mutable user data out of the read-only application directory.
WORKSPACE_ROOT=/srv/mycodexai/workspace
AGENT_STATE_ROOT=/srv/mycodexai/state/runs
AUTH_DATABASE_PATH=/srv/mycodexai/state/auth.db
AGENT_MAX_CONCURRENT_RUNS=1

# The initial administrator already exists. Never re-enable bootstrap on a public server.
AUTH_BOOTSTRAP_TOKEN=
AUTH_COOKIE_NAME=__Host-mycodexai_session
AUTH_COOKIE_SECURE=true
AUTH_SESSION_DAYS=1
AUTH_SESSION_IDLE_MINUTES=480
AUTH_MAX_ACTIVE_SESSIONS=2
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCKOUT_MINUTES=15
AUTH_RECOVERY_CODE_COUNT=10
AUTH_MFA_ENCRYPTION_KEY=REPLACE_WITH_A_NEW_FERNET_KEY
AUTH_REQUIRE_MFA_FOR_ADMIN=true

# Optional social sign-in. Configure both values for a provider, or leave both blank.
# Register these exact redirect URIs with the provider after replacing the domain:
# https://ai.example.com/api/auth/oauth/google/callback
# https://ai.example.com/api/auth/oauth/github/callback
OAUTH_STATE_TTL_SECONDS=600
OAUTH_REQUEST_TIMEOUT_SECONDS=10
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Replace with the exact public domain, without a trailing slash.
ALLOWED_HOSTS=ai.example.com
PUBLIC_ORIGIN=https://ai.example.com
FORCE_HTTPS=true
HSTS_MAX_AGE_SECONDS=63072000
MAX_REQUEST_BYTES=115343360

# Disable a browser that executes project HTML in public deployment.
BROWSER_QA_ENABLED=false
SANDBOX_MODE=docker
SANDBOX_DOCKER_EXECUTABLE=/usr/bin/docker
SANDBOX_DOCKER_IMAGE=mycodexai-sandbox:latest
SANDBOX_CONTAINER_USER=sandbox
SANDBOX_ALLOW_NETWORK=false
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=256
SANDBOX_BROWSER_EXECUTABLE=/usr/bin/chromium
